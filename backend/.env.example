# Pooled connection used by the application.
DATABASE_URL=

# Direct (non-pooled) connection used by Alembic migrations.
# Falls back to DATABASE_URL when unset.
MIGRATION_DATABASE_URL=

# Signs session tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Send session cookies only over HTTPS. Must be true in production.
COOKIE_SECURE=false

# Whether the browser may send the session cookie from another site. "lax" is
# right whenever the pages and the API share a domain, which is both the local
# setup and the deployed one. Only a split across two domains needs "none",
# and browsers honour that only when COOKIE_SECURE is also true.
COOKIE_SAMESITE=lax

# Where the site is served from. Only needed while the pages and the API are
# two servers, which is the case locally. Deployed they share one domain and
# nothing is cross-origin, so this can be left at its default there.
CORS_ORIGINS=["http://localhost:3000"]

ENVIRONMENT=development
