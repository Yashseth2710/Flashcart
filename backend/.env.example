# Pooled connection used by the application.
DATABASE_URL=

# Direct (non-pooled) connection used by Alembic migrations.
# Falls back to DATABASE_URL when unset.
MIGRATION_DATABASE_URL=

# Signs session tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Send session cookies only over HTTPS. Must be true in production.
COOKIE_SECURE=false

# Whether the browser may send the session cookie from another site. Leave as
# "lax" while the pages and the API share a domain. Deployed to two different
# domains they do not, and a lax cookie is never sent to the API, so set this
# to "none" there — which browsers only honour when COOKIE_SECURE is true.
COOKIE_SAMESITE=lax

# Where the site is served from. The browser will not send the session cookie
# across origins unless the origin is named here, so a deployed frontend on a
# different domain to the API must be listed or nobody stays signed in.
CORS_ORIGINS=["http://localhost:3000"]

ENVIRONMENT=development
